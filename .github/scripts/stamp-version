#!/bin/sh
# Stamp the release version from the git tag into Cargo.toml and Cargo.lock.
# The tag is the only source of truth; the committed version is 0.0.0.
set -eu

version=${GITHUB_REF_NAME:?}
if ! echo "$version" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$'; then
  echo "::error::tag $version is not a semver version (e.g. 1.2.3 or 1.2.3-rc.1)"
  exit 1
fi
grep -q '^version = "0.0.0"$' Cargo.toml || {
  echo "::error::Cargo.toml must contain version = \"0.0.0\""
  exit 1
}
sed -i.bak "s/^version = \"0.0.0\"$/version = \"$version\"/" Cargo.toml && rm Cargo.toml.bak
cargo update --workspace
echo "Stamped version $version"
